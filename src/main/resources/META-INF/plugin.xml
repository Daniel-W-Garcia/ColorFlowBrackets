<idea-plugin>
    <id>com.danielwgarcia.FreeColorflowBrackets</id>
    <name>Free Colorflow Brackets</name>
    <version>1.3.0</version>
    <vendor email="levelbasedbrackets@gmail.com"
            url="https://github.com/Daniel-W-Garcia">Daniel Garcia</vendor>

    <idea-version since-build="243"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <annotator language=""
                   implementationClass="com.danielwgarcia.freecolorflowbrackets.BracketAnnotation"/>
        <colorSettingsPage
                implementation="com.danielwgarcia.freecolorflowbrackets.BracketColorSettings"/>
    </extensions>
</idea-plugin>